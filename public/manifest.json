{
  "name": "SpikeLedger",
  "short_name": "SpikeLedger",
  "description": "Volleyball stats that are fair to every position",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f6f9",
  "theme_color": "#0b1a33",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://www.spikeledger.com/manifest.json"
    },
    {
      "platform": "webapp",
      "url": "https://spikeledger.vercel.app/manifest.json"
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192-v4.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-v4.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512-v4.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
