// SpikeLedger database schema
// Source of truth: SpikeLedger_ARCHITECTURE.md Section 3

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTHENTICATION & BILLING
// ============================================================

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  passwordHash         String
  role                 UserRole  @default(COACH)
  plan                 Plan      @default(FREE)
  stripeId             String?   @unique
  stripeSubscriptionId String?   @unique
  planExpiresAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Parent notification preferences. Push alerts are per device (see
  // PushSubscription); email is the fallback for parents without them.
  emailMatchAlerts       Boolean   @default(true)
  // Set when the parent taps "Maybe later" on the dashboard install card.
  installCardDismissedAt DateTime?

  clubs              ClubMember[]
  teams              Team[]
  chatUsage          ChatUsage[]
  parentLinks        ParentPlayerLink[] // players this PARENT user follows
  pushSubscriptions  PushSubscription[]
  matchNotifications MatchNotification[]
}

enum UserRole {
  COACH
  ADMIN
  ATHLETE
  PARENT
}

enum Plan {
  FREE
  COACH_PRO
  CLUB
}

// ============================================================
// ORGANIZATION
// ============================================================

model Club {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  country   String   @default("CA")
  province  String?
  createdAt DateTime @default(now())

  members ClubMember[]
  teams   Team[]
  invites ClubInvite[]
}

model ClubMember {
  id     String   @id @default(cuid())
  userId String
  clubId String
  role   ClubRole @default(COACH)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
}

enum ClubRole {
  OWNER
  COACH
  ASSISTANT
}

// ============================================================
// TEAMS & PLAYERS
// ============================================================

model Team {
  id        String   @id @default(cuid())
  name      String
  ageGroup  String?
  season    String?
  clubId    String?
  coachId   String
  createdAt DateTime @default(now())
  // false = "no positions" mode: everyone rotates through everything, the
  // Bank Account uses the universal formula, and position UI is hidden.
  usesPositions   Boolean @default(true)
  // Coach can pause the parent live view for the whole team.
  allowParentView Boolean @default(true)
  // Alert linked parents (push, else email) when a match starts.
  notifyParentsOnStart Boolean @default(true)

  club        Club?        @relation(fields: [clubId], references: [id])
  coach       User         @relation(fields: [coachId], references: [id], onDelete: Cascade)
  players     Player[]
  tournaments Tournament[]
}

model Player {
  id                String    @id @default(cuid())
  name              String
  number            Int?
  primaryPosition   Position
  secondaryPosition Position?
  teamId            String
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  // Parent access: a short shareable code ("HAWK-7K2") the coach hands to a
  // parent. Null until the coach issues one; cleared on revoke.
  parentCode            String?   @unique
  parentCodeCreatedAt   DateTime?
  // A code can be redeemed 3 times (parents, aunts, uncles) within 30 days
  // of being issued; both reset when the coach issues a fresh code.
  parentCodeRedemptions Int       @default(0)
  parentCodeExpiresAt   DateTime?

  team              Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  statLines         StatLine[]
  attendanceRecords Attendance[]
  parentLinks       ParentPlayerLink[]
}

// A PARENT user following one player. One parent can follow several players
// (siblings on different teams); one player can have several parents.
model ParentPlayerLink {
  id          String    @id @default(cuid())
  parentId    String
  playerId    String
  linkedAt    DateTime  @default(now())
  // Null until the coach dismisses the "X's parent linked" notice on the roster.
  coachSeenAt DateTime?

  parent User   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([parentId, playerId])
  @@index([playerId])
}

enum Position {
  OH
  RS
  MB
  S
  L
  DS
  OPP
  UTIL
}

// ============================================================
// COMPETITIONS
// ============================================================

model Tournament {
  id        String    @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime?
  location  String?
  teamId    String
  createdAt DateTime  @default(now())

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matches Match[]
}

model Match {
  id           String       @id @default(cuid())
  tournamentId String
  opponent     String
  matchNumber  Int
  setsWon        Int          @default(0)
  setsLost       Int          @default(0)
  opponentErrors Int          @default(0)
  result         MatchResult?
  createdAt      DateTime     @default(now())
  // Set when the coach confirms the starting lineup ("Start match").
  startedAt      DateTime?

  tournament    Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  statLines     StatLine[]
  setScores     MatchSetScore[]
  notifications MatchNotification[]
}

// Live per-set score synced from the courtside page so the parent view (and
// the set win probability) can follow the match point by point. `history`
// is the sequence of [us, them] scores after each point in that set.
model MatchSetScore {
  id        String   @id @default(cuid())
  matchId   String
  setNumber Int
  us        Int      @default(0)
  them      Int      @default(0)
  history   Json     @default("[]")
  updatedAt DateTime @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, setNumber])
}

enum MatchResult {
  WIN
  LOSS
  DRAW
}

// ============================================================
// STAT LINES — atomic unit of analytics data
// ============================================================

model StatLine {
  id       String @id @default(cuid())
  matchId  String
  playerId String

  // Attacking
  kills          Int @default(0)
  attackErrors   Int @default(0)
  attackAttempts Int @default(0)

  // Serving
  aces          Int @default(0)
  serveErrors   Int @default(0)
  serveAttempts Int @default(0)

  // Blocking
  blocks      Int @default(0)
  blockErrors Int @default(0)

  // Setting
  assists       Int @default(0)
  settingErrors Int @default(0)

  // Serve Receive (SR 0/1/2/3 breakdown — drives the Bank Account passing logic)
  sr0 Int @default(0)
  sr1 Int @default(0)
  sr2 Int @default(0)
  sr3 Int @default(0)

  // General
  generalErrors Int @default(0)
  digs          Int @default(0)

  // Playing time
  setsPlayed Int     @default(0)
  didNotPlay Boolean @default(false)

  // What position they played THIS match (handles dual-role players)
  positionPlayed Position?

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
}

// ============================================================
// ATTENDANCE
// ============================================================

model Attendance {
  id       String           @id @default(cuid())
  playerId String
  date     DateTime
  type     AttendanceType
  status   AttendanceStatus

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

enum AttendanceType {
  PRACTICE
  MATCH
  CAMP
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// ============================================================
// GENERATED REPORTS
// ============================================================

model Report {
  id          String     @id @default(cuid())
  type        ReportType
  scope       String
  imageUrls   String[]
  metadata    Json?
  generatedAt DateTime   @default(now())
  teamId      String
}

enum ReportType {
  PLAYER_INDIVIDUAL
  PLAYER_SEASON
  TEAM_TOURNAMENT
  TEAM_SEASON
  BANK_ACCOUNT
  PARENT_REPORT
  WHATSAPP_PACKAGE
}

// ============================================================
// AI INSIGHT CACHE
// ============================================================
// LLM calls take 5–30s. We hash the request payload and stash the parsed
// response — same stats produce the same insight, no point re-asking Gemma.

model AIInsightCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  kind      String   // "player" | "team"
  response  Json
  provider  String   // "ollama" | "google" | "rule-based"
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([cacheKey, expiresAt])
}

// ============================================================
// COACH CHAT USAGE
// ============================================================
// Daily message counter for the "Ask Coach AI" chat assistant. One row per
// user per UTC day; the API route increments it and enforces the plan's
// per-day cap (Coach Pro 50, Club 200).

model ChatUsage {
  id     String @id @default(cuid())
  userId String
  day    String // UTC date, "YYYY-MM-DD"
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// ============================================================
// CLUB INVITES
// ============================================================
// Shareable invite links for the Club tier. No email delivery yet - the
// owner copies the /invite/[code] link and shares it. Codes expire after
// 14 days; acceptance writes the ClubMember row.

model ClubInvite {
  id           String    @id @default(cuid())
  clubId       String
  code         String    @unique
  email        String
  role         ClubRole  @default(COACH)
  invitedById  String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

// One browser/device a parent turned alerts on for. Deactivated when the push
// service says the subscription is gone (404/410), or when the parent turns
// alerts off on that device.
model PushSubscription {
  id            String    @id @default(cuid())
  parentId      String
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  active        Boolean   @default(true)
  // The push service reported the endpoint gone; the browser must subscribe
  // again to get a new one.
  expiredAt     DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  parent User @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, active])
}

enum NotificationChannel {
  PUSH
  EMAIL
  NONE
}

enum NotificationStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

// One row per (match, parent), claimed before anything is sent, so a match
// can never alert the same parent twice. Doubles as the audit trail.
model MatchNotification {
  id        String              @id @default(cuid())
  matchId   String
  parentId  String
  // The parent's own children in the starting lineup (never anyone else).
  playerIds String[]
  channel   NotificationChannel @default(NONE)
  status    NotificationStatus  @default(PENDING)
  reason    String?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  parent User  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([matchId, parentId])
  @@index([parentId, createdAt])
}
