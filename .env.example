# ===========================================================================
# SpikeLedger — environment variables
# Copy this file to `.env` and fill in real values.
# ===========================================================================

# --- Database ---------------------------------------------------------------
# Local development uses the Neon DEV branch, never production. Put the dev
# branch's connection string here AND in .env.local (see README, "Development
# database"). Production's string belongs only in Vercel; the seed, the
# scripts and any Next server not built on Vercel all refuse it.
#   Neon dev branch: postgresql://USER:PASS@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://spikeledger:spikeledger@localhost:5432/spikeledger"

# --- NextAuth ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Match-start alerts for parents ------------------------------------------
# Web push: when a coach taps Start match, parents of the starters who turned
# alerts on get a phone/desktop notification. Generate the key pair ONCE with
#   npx web-push generate-vapid-keys
# and keep it: a new pair breaks every parent's existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:support@spikeledger.com"

# Email fallback for parents without alerts, via Resend (https://resend.com,
# free tier 3,000 emails/month). Leave RESEND_API_KEY empty and no emails are
# sent; nothing else breaks. EMAIL_FROM must use a domain verified in Resend
# (onboarding@resend.dev only delivers to your own Resend account address).
RESEND_API_KEY=
EMAIL_FROM="SpikeLedger <onboarding@resend.dev>"

# --- AI Coaching Insights & Coach Chat ---------------------------------------
# Anthropic (Claude) is the only LLM provider. When ANTHROPIC_API_KEY is set,
# coaching insights, team analysis, and the "Ask Coach AI" chat use Claude;
# otherwise insights fall back to the always-available rule-based engine (and
# chat returns a graceful "unavailable" message). Get a key (starts with
# "sk-ant-...") from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Stripe (billing) --------------------------------------------------------
# Optional. Without STRIPE_SECRET_KEY the billing routes return 503 and the
# upgrade buttons are hidden; everything else works. All prices are in USD:
# create the products in the Stripe Dashboard with USD prices and paste the
# `price_...` IDs below.
#   SpikeLedger Coach Pro: $9.99 USD / month, $99.99 USD / year
#   SpikeLedger Club:      $49.99 USD / month, $499.99 USD / year
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COACH_PRO_MONTHLY_PRICE_ID=
STRIPE_COACH_PRO_YEARLY_PRICE_ID=
STRIPE_CLUB_MONTHLY_PRICE_ID=
STRIPE_CLUB_YEARLY_PRICE_ID=

# Guards /api/cron/dunning, the daily payment-reminder sweep. Set the same
# value here and in Vercel; Vercel Cron sends it automatically as a bearer
# token. Generate one with: openssl rand -base64 32
CRON_SECRET=
