# ===========================================================================
# SpikeLedger — environment variables
# Copy this file to `.env` and fill in real values.
# ===========================================================================

# --- Database ---------------------------------------------------------------
# Local Postgres examples:
#   Docker:   postgresql://spikeledger:spikeledger@localhost:5432/spikeledger
#   Native:   postgresql://postgres:postgres@localhost:5432/spikeledger
#   Neon:     postgresql://USER:PASS@HOST.neon.tech/spikeledger?sslmode=require
DATABASE_URL="postgresql://spikeledger:spikeledger@localhost:5432/spikeledger"

# --- NextAuth ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Match-start alerts for parents ------------------------------------------
# Web push: when a coach taps Start match, parents of the starters who turned
# alerts on get a phone/desktop notification. Generate the key pair ONCE with
#   npx web-push generate-vapid-keys
# and keep it: a new pair breaks every parent's existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:support@spikeledger.com"

# Email fallback for parents without alerts, via Resend (https://resend.com,
# free tier 3,000 emails/month). Leave RESEND_API_KEY empty and no emails are
# sent; nothing else breaks. EMAIL_FROM must use a domain verified in Resend
# (onboarding@resend.dev only delivers to your own Resend account address).
RESEND_API_KEY=
EMAIL_FROM="SpikeLedger <onboarding@resend.dev>"

# --- AI Coaching Insights & Coach Chat ---------------------------------------
# Anthropic (Claude) is the only LLM provider. When ANTHROPIC_API_KEY is set,
# coaching insights, team analysis, and the "Ask Coach AI" chat use Claude;
# otherwise insights fall back to the always-available rule-based engine (and
# chat returns a graceful "unavailable" message). Get a key (starts with
# "sk-ant-...") from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
