# ===========================================================================
# SpikeLedger — environment variables
# Copy this file to `.env` and fill in real values.
# ===========================================================================

# --- Database ---------------------------------------------------------------
# Local Postgres examples:
#   Docker:   postgresql://spikeledger:spikeledger@localhost:5432/spikeledger
#   Native:   postgresql://postgres:postgres@localhost:5432/spikeledger
#   Neon:     postgresql://USER:PASS@HOST.neon.tech/spikeledger?sslmode=require
DATABASE_URL="postgresql://spikeledger:spikeledger@localhost:5432/spikeledger"

# --- NextAuth ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- AI Coaching Insights & Coach Chat ---------------------------------------
# Provider fallback chain: Anthropic (Claude) -> Google -> Ollama -> rule-based.
# Claude is always preferred when ANTHROPIC_API_KEY is set; the coach chat
# assistant ("Ask Coach AI") requires it. If no LLM is reachable, insights
# silently fall back to rule-based so the app keeps working.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Secondary preference when Claude is not configured: "ollama" (local, free)
# or "google" (hosted, requires key).
AI_PROVIDER=ollama

# Local Ollama (default). Install: curl -fsSL https://ollama.com/install.sh | sh
# Then:                            ollama pull gemma4
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4

# Hosted Google AI fallback (optional). Get an API key (starts with "AIza...")
# from https://aistudio.google.com/app/apikey - NOT an OAuth token.
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash
